# AT Protocol OAuth Configuration
# 
# IMPORTANT: These are BUILD-TIME variables for Vite/React Router.
# They must be set when building the Docker image or running npm build.
# Setting them at runtime has no effect on the bundled JavaScript.
#
# For Docker builds, pass as build arguments:
# docker build --build-arg VITE_OAUTH_CLIENT_ID="..." --build-arg VITE_OAUTH_REDIRECT_URI="..." .
#
# For local development, set in .env file (Vite will read them):
# VITE_OAUTH_CLIENT_ID="http://localhost"
# VITE_OAUTH_REDIRECT_URI="http://127.0.0.1:5173"
#
# For production (these are hardcoded in GitHub Actions workflow):
# VITE_OAUTH_CLIENT_ID="https://at-workout.shypan.st/.well-known/oauth-client-metadata"
# VITE_OAUTH_REDIRECT_URI="https://at-workout.shypan.st/"

VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=
